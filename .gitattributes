# Auto-detect text files and normalize line endings to LF in the repository.
* text=auto eol=lf

# Windows-specific text files keep CRLF.
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.bat text eol=crlf

# Binary formats: never normalize, never diff as text.
*.png binary
*.jpg binary
*.wav binary
*.mid binary
*.f64 binary
*.exe binary
*.dll binary
